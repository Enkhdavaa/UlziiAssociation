---
import MainLayout from '../../layouts/MainLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents, getAllLeads } from '../../lib/kv';
import '../_index.css';
import '../event/_event.css';
import { useTranslations, isValidLocale, DEFAULT_LOCALE } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const { lang } = Astro.params;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}`);
const locale = lang as Locale;
const t = useTranslations(locale);

// Same "upcoming" rule as the events page; events come back sorted by date
const [allEvents, allLeads] = await Promise.all([getEvents(), getAllLeads()]);
const today = new Date();
today.setHours(0, 0, 0, 0);
const nextEvent = allEvents.find(e => new Date(e.date + 'T00:00:00') >= today);
const nextEventHasLead = nextEvent ? allLeads.some(l => l.eventId === nextEvent.id) : false;

const offers = [
  { href: `/${lang}/books`, title: t('home.offerLibraryTitle'), text: t('home.offerLibraryText') },
  { href: `/${lang}/event`, title: t('home.offerStoryTitle'), text: t('home.offerStoryText') },
  { href: `/${lang}/support/donate-books`, title: t('home.offerDonateTitle'), text: t('home.offerDonateText') },
];
---

<MainLayout lang={locale}>
    <section class="hero">
        <div class="hero-inner">
            <h1>{t('home.headline')}</h1>
            <p class="hero-sub">{t('home.sub')}</p>
            <div class="hero-actions">
                <a href={`/${lang}/event`} class="btn btn-primary">{t('home.ctaEvents')}</a>
                <a href={`/${lang}/contact`} class="text-link">{t('home.ctaContact')}</a>
            </div>
        </div>
        {/* PHOTO: when you have one, add it here, e.g.
            <img class="hero-photo" src="/photos/storytelling.jpg" alt="Children listening to a story at Ulzii" /> */}
    </section>

    <section class="home-section">
        <h2 class="section-heading">{t('home.offerHeading')}</h2>
        <ul class="offer-list" role="list">
            {offers.map(offer => (
                <li>
                    <a href={offer.href}>{offer.title}</a>
                    <p>{offer.text}</p>
                </li>
            ))}
        </ul>
    </section>

    <section class="home-section next-event">
        <h2 class="section-heading">{t('home.nextEventHeading')}</h2>
        {nextEvent ? (
            <EventCard event={nextEvent} hasLead={nextEventHasLead} lang={locale} />
        ) : (
            <p class="next-event-empty">{t('events.empty')}</p>
        )}
        <a href={`/${lang}/event`} class="text-link">{t('home.allEvents')}</a>
    </section>

    <section class="home-section">
        <h2 class="section-heading">{t('home.aboutHeading')}</h2>
        <div class="about-grid">
            <div>
                <h3><svg aria-hidden="true" class="about-icon"><use href="/svgs.svg#mission"></use></svg>{t('home.mission')}</h3>
                <p>{t('home.missionText')}</p>
            </div>
            <div>
                <h3><svg aria-hidden="true" class="about-icon"><use href="/svgs.svg#values"></use></svg>{t('home.values')}</h3>
                <p>{t('home.valuesText')}</p>
            </div>
            <div>
                <h3><svg aria-hidden="true" class="about-icon"><use href="/svgs.svg#board-members"></use></svg>{t('home.board')}</h3>
                <p>{t('home.boardText')}</p>
            </div>
        </div>
    </section>
</MainLayout>
